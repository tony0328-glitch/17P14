
#include <Servo.h>

// Arduino pin assignment
#define PIN_IR    A0
#define PIN_LED   9
#define PIN_SERVO 10

// Servo duty values
#define _DUTY_MIN 1000
#define _DUTY_NEU 1500
#define _DUTY_MAX 2000

// Distance range (mm)
#define _DIST_MIN 100.0
#define _DIST_MAX 250.0

// EMA filter
#define EMA_ALPHA 0.3

// Loop interval (msec)
#define LOOP_INTERVAL 25

Servo myservo;

unsigned long last_loop_time = 0;

float dist_prev = _DIST_MIN;
float dist_ema = _DIST_MIN;

void setup()
{
  pinMode(PIN_LED, OUTPUT);
  digitalWrite(PIN_LED, LOW);

  myservo.attach(PIN_SERVO);
  myservo.writeMicroseconds(_DUTY_NEU);

  Serial.begin(1000000);
  last_loop_time = millis();
}

void loop()
{
  unsigned long time_curr = millis();
  int duty;
  float a_value, dist_raw;

  // Wait until next event time
  if ((unsigned long)(time_curr - last_loop_time)
      < LOOP_INTERVAL)
    return;

  last_loop_time += LOOP_INTERVAL;

  // Read IR sensor
  a_value = analogRead(PIN_IR);

  // Convert ADC value to distance
  if (a_value > 9.0)
  {
    dist_raw = ((6762.0 / (a_value - 9.0))
                - 4.0) * 10.0 - 60.0;
  }
  else
  {
    dist_raw = _DIST_MAX + 1.0;
  }

  // Range filter and LED control
  if (dist_raw >= _DIST_MIN &&
      dist_raw <= _DIST_MAX)
  {
    digitalWrite(PIN_LED, HIGH);
    dist_prev = dist_raw;
  }
  else
  {
    digitalWrite(PIN_LED, LOW);
  }

  // EMA filter
  dist_ema = EMA_ALPHA * dist_prev
           + (1.0 - EMA_ALPHA) * dist_ema;

  // Linear interpolation without map()
  duty = _DUTY_MIN
       + (int)((dist_ema - _DIST_MIN)
       * (_DUTY_MAX - _DUTY_MIN)
       / (_DIST_MAX - _DIST_MIN));

  duty = constrain(duty, _DUTY_MIN, _DUTY_MAX);

  // Servo control
  myservo.writeMicroseconds(duty);

  // Serial Plotter output
  Serial.print("_DUTY_MIN:");
  Serial.print(_DUTY_MIN);

  Serial.print(",_DIST_MIN:");
  Serial.print(_DIST_MIN);

  Serial.print(",IR:");
  Serial.print(a_value);

  Serial.print(",dist_raw:");
  Serial.print(dist_raw);

  Serial.print(",ema:");
  Serial.print(dist_ema);

  Serial.print(",servo:");
  Serial.print(duty);

  Serial.print(",_DIST_MAX:");
  Serial.print(_DIST_MAX);

  Serial.println(",_DUTY_MAX:" + String(_DUTY_MAX));
}
